<Window
    x:Class="DupePhotos.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DupePhotos"
    x:CompileBindings="False"
    Width="1080"
    Height="760"
    MinWidth="780"
    MinHeight="520">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="DupePhotos" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.72" />
                <TextBlock Text="{Binding SelectedFolder}" Opacity="0.56" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding PickFolderCommand}" MinWidth="132" VerticalAlignment="Center">
                <TextBlock Text="Choose folder" />
            </Button>

            <Button Grid.Column="2" Command="{Binding CancelScanCommand}" MinWidth="96" VerticalAlignment="Center">
                <TextBlock Text="Cancel" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,18,0,18">
            <ProgressBar IsIndeterminate="{Binding IsScanning}" Value="{Binding ScanPercent}" Maximum="100" Height="6" VerticalAlignment="Center" />

            <Button Grid.Column="1" Command="{Binding AutoSelectDuplicatesCommand}" MinWidth="156">
                <TextBlock Text="Auto select dupes" />
            </Button>

            <Button Grid.Column="2" Command="{Binding DeleteSelectedCommand}" MinWidth="164">
                <TextBlock Text="Recycle selected" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.72" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Opacity="0.72" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,112,*" ColumnSpacing="14" Margin="0,8">
                                                <CheckBox IsChecked="{Binding IsSelectedForDelete}" VerticalAlignment="Center" />

                                                <Border Grid.Column="1" Width="96" Height="96" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" Opacity="0.72" />
                                                    <TextBlock Text="{Binding Path}" Opacity="0.56" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding KeepHint}" Foreground="#0067C0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
